{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": ["vpcEndpointCidrs", "yet-another-cloudwatch-exporter"],
  "properties": {
    "vpcEndpointCidrs": {
      "type": "object",
      "required": ["tagging"],
      "properties": {
        "tagging": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "yet-another-cloudwatch-exporter": {
      "type": "object",
      "required": ["region", "clusterName"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "clusterName": { "type": "string", "minLength": 1 }
      }
    }
  }
}
