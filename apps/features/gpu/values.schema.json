{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "required": [
        "spec"
      ],
      "properties": {
        "spec": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "object",
              "required": [
                "repoURL"
              ],
              "properties": {
                "repoURL": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "appParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
